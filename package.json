{
  "name": "vatrolog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy && next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "check:client-imports": "node scripts/check-client-server-imports.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:client-imports",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "seed": "prisma db seed",
    "seed:platform-user": "node scripts/seed-platform-user.js",
    "seed:mfr": "node scripts/seed-manufacturers.js",
    "seed:pastor-types": "ts-node -P tsconfig.seed.json scripts/import-manufacturer-types.ts",
    "seed:pastor-parts": "ts-node -P tsconfig.seed.json scripts/import-manufacturer-parts.ts",
    "seed:common-types": "ts-node -P tsconfig.seed.json scripts/import-common-types-all-manufacturers.ts",
    "seed:pastor-parts-all-types": "ts-node -P tsconfig.seed.json scripts/link-pastor-parts-all-types.ts",
    "seed:basic-parts": "ts-node -P tsconfig.seed.json scripts/seed-basic-parts-all-manufacturers.ts",
    "seed:pucz-mfr": "ts-node -P tsconfig.seed.json prisma/seed-pucz-manufacturers.ts",
    "seed:orders": "ts-node -P tsconfig.seed.json prisma/seed-sim-orders.ts",
    "seed:5x30": "ts-node -P tsconfig.seed.json prisma/seed-sim-5x30.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:setup": "docker compose up -d && prisma migrate deploy && prisma generate && prisma db seed",
    "typecheck": "tsc --noEmit",
    "audit:tenant": "node scripts/audit-tenant-isolation.mjs",
    "cleanup:demo-mfr": "node scripts/cleanup-demo-manufacturers.mjs",
    "backfill:service-labels": "node scripts/backfill-service-labels.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "restore:db": "node scripts/restore-db.mjs",
    "verify:prod-env": "ts-node -P tsconfig.seed.json scripts/verify-prod-env.ts",
    "smoke:prod": "node scripts/smoke-prod-deploy.mjs",
    "smoke:delivery-note": "ts-node -P tsconfig.seed.json scripts/smoke-delivery-note-number.ts",
    "version:bump": "node scripts/bump-app-version.mjs",
    "mockups:gen": "node scripts/generate-mockup-pngs.mjs",
    "icons:build": "node scripts/build-favicons.mjs"
  },
  "prisma": {
    "seed": "ts-node -P tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@prisma/client": "6.19.1",
    "@react-pdf/renderer": "^4.3.0",
    "@sentry/nextjs": "^10.49.0",
    "@types/nodemailer": "^8.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "jose": "^6.1.3",
    "next": "16.1.1",
    "nodemailer": "^8.0.5",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "stripe": "^22.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "playwright": "^1.60.0",
    "prisma": "6.19.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
