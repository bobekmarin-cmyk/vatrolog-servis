# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.cursor/*
# Bugbot upute za pregled moraju biti u repou da ih Bugbot procita
!.cursor/BUGBOT.md

# local Docker DB creds (copy from postgres.env.example)
postgres.env

# smoke-test artifacts
.tmp-smoke-cookie.txt

# restore drill artefakti (preuzeti dump-ovi, dekriptirani plaintext)
.tmp-restore/

# helper files used to pass multi-line commit messages on Windows
.commitmsg.txt

# stray archives (do not commit)
/prisma.zip
/src.zip

.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# locally generated PDFs
/storage
